{
  "name": "crm-bi",
  "version": "1.1.0",
  "private": true,
  "description": "Spring Boot + PostgreSQL 18 CRM 与 BI 分析平台，支持客户全旅程、RLS 数据权限、报表、指标和驾驶舱",
  "type": "commonjs",
  "engines": { "node": ">=22" },
  "scripts": {
    "initdb": "node server/db/init.js",
    "setup": "node scripts/setup.js",
    "db:up": "node scripts/setup.js --db-only",
    "db:migrate": "node server/db/migrate.js",
    "db:backup": "node scripts/backup.js",
    "start": "docker compose up -d --build app",
    "stop": "docker compose down",
    "build": "docker build -t crm-bi:local .",
    "test": "node scripts/smoke.js && node scripts/crmcheck.js",
    "test:pg": "node scripts/pgcheck.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "bcryptjs": "^2.4.3",
    "pg": "^8.13.1"
  }
}
