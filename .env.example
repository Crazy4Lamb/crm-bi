# npm run setup generates .env with random local passwords when it does not exist.
DB_MODE=pg
PORT=8787
APP_TZ=Asia/Shanghai
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=crm_bi
PGUSER=crm_app
PGPASSWORD=replace-with-your-app-password
PGADMIN_USER=crm_owner
PGADMIN_PASSWORD=replace-with-your-migration-password
PGPOOL_MAX=15
PG_STATEMENT_TIMEOUT_MS=15000
JWT_SECRET=replace-with-at-least-32-random-characters
BACKFILL_DAYS=120

